<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JobDispatcherNET</PackageId>
    <Title>JobDispatcherNET</Title>
    <Description>Lock-free actor-style job dispatcher for .NET game servers. Each object owns its job queue, so work on the same object is serialized without locks, while different objects run fully in parallel. Dedicated OS worker threads, allocation-free hot path, cancellable timers, back-pressure and built-in metrics.</Description>
    <PackageTags>actor;game-server;lock-free;concurrency;dispatcher;threading;mmorpg;queue;scheduler</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/jacking75/JobDispatcherNET/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobDispatcherNET.Tests" />
    <InternalsVisibleTo Include="JobDispatcherNET.Benchmarks" />
  </ItemGroup>

</Project>

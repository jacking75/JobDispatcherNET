<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JobDispatcherNET.Extensions.Logging</PackageId>
    <Title>JobDispatcherNET.Extensions.Logging</Title>
    <Description>Microsoft.Extensions.Logging adapter for JobDispatcherNET. Routes the library's IJobLogger output into any ILogger pipeline (Serilog, NLog, console, ...) so the core package can stay dependency-free.</Description>
    <PackageTags>actor;game-server;logging;microsoft-extensions-logging;ilogger;dispatcher;concurrency</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/jacking75/JobDispatcherNET/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobDispatcherNET\JobDispatcherNET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>

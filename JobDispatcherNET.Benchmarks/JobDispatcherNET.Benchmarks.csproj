<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>JobDispatcherNET.Benchmarks</AssemblyName>
    <RootNamespace>JobDispatcherNET.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>

    <!-- The repo-wide Directory.Build.props turns the .NET analyzers on. Benchmark code
         deliberately breaks a few of their rules (public mutable fields for [Params],
         allocating closures on purpose, sync waits), so warnings must not fail the build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- NU1510: on net10.0 Dataflow ships in the shared framework, but the explicit reference is
         kept so the comparison target is pinned and the project still builds on older TFMs. -->
    <NoWarn>$(NoWarn);CA1002;CA1051;CA1707;CA1812;CA1815;CA1819;CA2007;CA5394;NU1510</NoWarn>

    <!-- BenchmarkDotNet requires a Release build with optimizations and no debug tiering. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobDispatcherNET\JobDispatcherNET.csproj" />
  </ItemGroup>

</Project>
